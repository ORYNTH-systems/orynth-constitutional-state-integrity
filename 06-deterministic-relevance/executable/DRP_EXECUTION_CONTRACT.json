{
    "schema_version":  "0.6.0",
    "resolver":  "DETERMINISTIC_RELEVANCE_PROPAGATION",
    "inputs":  [
                   "node_id",
                   "dependency_graph"
               ],
    "outputs":  [
                    "retrospective_relevance",
                    "prospective_relevance"
                ],
    "invariants":  {
                       "retrospective_relevance_is_not_reversal":  true,
                       "prospective_relevance_is_not_authority":  true,
                       "traversal_preserves_dependency_direction":  true,
                       "provenance_required":  true
                   }
}
